{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tickflare-tic-tac-toe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TicTacToe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TicTacToe"] }]
}
