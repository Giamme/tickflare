{
  "name": "duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Duel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Duel"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "duel" }],
  // For local development only. Use `wrangler secret put JOIN_SECRET` for a deployed Worker.
  "vars": { "JOIN_SECRET": "local-development-only-secret" }
}
