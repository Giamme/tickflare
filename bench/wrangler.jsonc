{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tickflare-bench",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Bench" },
      { "name": "IDLE", "class_name": "Idle" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bench", "Idle"] }]
}
