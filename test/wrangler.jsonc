{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tickflare-test",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "TestRoom" },
      { "name": "TICKS", "class_name": "TickRoom" },
      { "name": "TURNS", "class_name": "TurnRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestRoom", "TickRoom", "TurnRoom"] }]
}
