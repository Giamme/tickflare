{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tickflare-test",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "TestRoom" },
      { "name": "TICKS", "class_name": "TickRoom" },
      { "name": "TURNS", "class_name": "TurnRoom" },
      { "name": "ASKED", "class_name": "AskedTurnRoom" },
      { "name": "MATCHMAKER", "class_name": "TestMatchmaker" },
      { "name": "AWAY", "class_name": "AwayRoom" },
      { "name": "PATIENT", "class_name": "PatientMatchmaker" },
      { "name": "EDGE", "class_name": "EdgeRoom" },
      { "name": "LAZY", "class_name": "LazyTickRoom" },
      { "name": "HALF", "class_name": "HalfRate" },
      { "name": "SLOW", "class_name": "SlowLobby" },
      { "name": "FLAKY", "class_name": "FlakyLobby" },
      { "name": "NAMES", "class_name": "NameRoom" },
      { "name": "SHAPES", "class_name": "ShapesRoom" },
      { "name": "PLAIN", "class_name": "PlainShapesRoom" },
      { "name": "SNAPS", "class_name": "SnapRoom" },
      { "name": "ASKEDSNAPS", "class_name": "AskedSnapRoom" },
      { "name": "RANKED", "class_name": "RankedMatchmaker" },
      { "name": "WIDENING", "class_name": "WideningMatchmaker" },
      { "name": "TRIOS", "class_name": "RankedTrios" },
      { "name": "REGIONAL", "class_name": "RegionalMatchmaker" },
      { "name": "QUIET", "class_name": "QuietRoom" },
      { "name": "PARTIES", "class_name": "PartyMatchmaker" },
      { "name": "TEAMS", "class_name": "TeamMatchmaker" },
      { "name": "ZONES", "class_name": "ZoneRoom" },
      { "name": "EVENTZONES", "class_name": "EventZoneRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TestRoom", "TickRoom", "TurnRoom", "TestMatchmaker", "AwayRoom", "PatientMatchmaker", "EdgeRoom", "LazyTickRoom", "HalfRate", "SlowLobby", "FlakyLobby"] },
    { "tag": "v2", "new_sqlite_classes": ["NameRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["AskedTurnRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["ShapesRoom", "PlainShapesRoom"] },
    { "tag": "v5", "new_sqlite_classes": ["SnapRoom", "AskedSnapRoom"] },
    { "tag": "v6", "new_sqlite_classes": ["RankedMatchmaker", "WideningMatchmaker", "RankedTrios", "RegionalMatchmaker"] },
    { "tag": "v7", "new_sqlite_classes": ["QuietRoom"] },
    { "tag": "v8", "new_sqlite_classes": ["PartyMatchmaker", "TeamMatchmaker"] },
    { "tag": "v9", "new_sqlite_classes": ["ZoneRoom", "EventZoneRoom"] }
  ],
  "queues": {
    "producers": [{ "binding": "MATCHES", "queue": "tickflare-test-matches" }],
    "consumers": [{ "queue": "tickflare-test-matches", "max_batch_size": 10, "max_batch_timeout": 1 }]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tickflare-test", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "tickflare-test-replays" }]
}
